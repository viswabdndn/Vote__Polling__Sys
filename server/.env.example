# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# MongoDB connection URI (e.g., mongodb://127.0.0.1:27017/online_polling or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/online_polling

# Authentication & Security
# WARNING: Rotate this secret in production! Generate a strong random key (min. 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRE=7d

# CORS Allowed Origin(s)
# Single origin or comma-separated list of allowed frontend URLs
CLIENT_URL=http://localhost:5173

# Initial Admin Credentials (used by setup:admin script)
# Ensure these credentials are changed upon first deployment
ADMIN_EMAIL=admin@polllive.local
ADMIN_PASSWORD=ReplaceWithStrongAdminPass123!
ADMIN_NAME=System Administrator
ADMIN_VOTER_ID=admin01
